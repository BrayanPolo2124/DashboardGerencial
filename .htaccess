# ----------------------------------------------------------------------
# SEGURIDAD MÁXIMA ANTI-HACKERS & BOTS (Vynet360)
# ----------------------------------------------------------------------

# 1. Ocultar información del servidor y deshabilitar listado de directorios
Options -Indexes -MultiViews
ServerSignature Off

# 2. Protección contra clickjacking, XSS y Sniffing de MIME
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Content Security Policy estricta
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self' http://127.0.0.1:11434;"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Bloquear Bots de IA y Crawlers maliciosos
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT|Anthropic|ClaudeBot|CCBot|Bytespider|PetalBot|SemrushBot|AhrefsBot) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# 4. Protección contra Inyecciones SQL, LFI y XSS mediante URL
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{QUERY_STRING} (?:%27|'|%22|") [NC,OR]
    RewriteCond %{QUERY_STRING} (?:%23|#) [NC,OR]
    RewriteCond %{QUERY_STRING} (?:%3B|;) [NC,OR]
    RewriteCond %{QUERY_STRING} (?:\b|%20)(?:UNION|SELECT|INSERT|UPDATE|DELETE|DROP|TRUNCATE|ALTER|CREATE|RENAME|EXEC|EXECUTE|DECLARE)(?:\b|%20) [NC,OR]
    RewriteCond %{QUERY_STRING} (?:\b|%20)(?:CONCAT|CHAR|LOAD_FILE|OUTFILE)(?:\b|%20) [NC,OR]
    RewriteCond %{QUERY_STRING} (?:%3C|<).*?(?:%3E|>) [NC,OR]
    RewriteCond %{QUERY_STRING} (?:javascript|vbscript|expression|applet|meta|xml|blink|link|style|script|object|iframe|frame|frameset|ilayer|layer|bgsound|title|base) [NC,OR]
    RewriteCond %{QUERY_STRING} (?:base64_encode|base64_decode|eval|system|shell_exec|passthru) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# 5. Proteger archivos sensibles (Ya no bloquea install.php desde aquí)
<FilesMatch "^\.env|config\.php|composer\.(json|lock)$">
    Require all denied
</FilesMatch>

# 5.1. Bloqueo Inteligente de Instalador: Si config.php existe, bloquea install.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} install\.php$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/config.php -f
    RewriteRule .* - [F,L]
</IfModule>

# 6. Enrutamiento MVC (Todas las peticiones van a index.php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php85” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php85 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
